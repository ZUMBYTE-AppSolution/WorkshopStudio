<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.PackagePreviewWindow" Title="Upload-Paket prüfen" Width="1040" Height="800" MinWidth="700" MinHeight="530" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="Das wird hochgeladen" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,6"/><TextBlock Text="Lokale Paketvorschau. Es wurde nichts an Steam übertragen. Die Quelldateien bleiben unverändert." Style="{StaticResource Muted}"/></StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Dateien im Upload"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="FilterBox" TextChanged="FilterChanged" ToolTip="Dateiliste nach Pfad filtern" Margin="0,0,0,12" AutomationProperties.Name="Upload-Dateien filtern"/><DataGrid x:Name="FileGrid" Grid.Row="1" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="PFAD IM UPLOADPAKET" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="GRÖSSE" Binding="{Binding SizeLabel}" Width="110"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="220"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Quelle → Paket"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Enthaltene Quellordner" Style="{StaticResource SectionTitle}"/><TextBox x:Name="MappingBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="130" Margin="0,0,0,14"/><TextBlock x:Name="Warnings" Style="{StaticResource Muted}"/><TextBlock Text="Angelegte Verzeichnisse (einschließlich leerer common/-Ordner)" Style="{StaticResource FieldLabel}" Margin="0,20,0,7"/><TextBox x:Name="DirectoriesBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="SteamCMD / VDF"><TextBox x:Name="VdfBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button DockPanel.Dock="Right" Content="Schließen" IsCancel="True" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconClose}"/><WrapPanel><Button Content="Paketordner öffnen" Click="Open_Click" Margin="0,0,10,0" icons:Iconify.Icon="{StaticResource IconFolder}"/><Button Content="Dateiliste speichern" Click="Save_Click" icons:Iconify.Icon="{StaticResource IconSave}"/></WrapPanel></DockPanel>
  </Grid>
</Window>
