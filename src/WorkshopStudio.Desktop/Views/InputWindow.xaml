<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.InputWindow" Width="570" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <StackPanel Margin="28">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,13"/>
    <TextBlock x:Name="Prompt" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
    <TextBox x:Name="Plain" Margin="0,0,0,18"/>
    <PasswordBox x:Name="Secret" Margin="0,0,0,18"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0" icons:Iconify.Icon="{StaticResource IconStop}"/>
      <Button Content="Weiter" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Accept_Click" icons:Iconify.Icon="{StaticResource IconCheck}"/>
    </StackPanel>
  </StackPanel>
</Window>
