<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.ConfigWindow" Title="Config / Befehle" Width="1040" Height="760" MinWidth="660" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StateText" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Files" DisplayMemberPath="RelativePath" SelectionChanged="Files_SelectionChanged" Margin="0,0,10,0"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" ToolTip="Text im Original suchen" KeyDown="Search_KeyDown" Margin="0,0,10,0"/>
      <Button Grid.Column="2" Content="Suchen" Click="Find_Click" icons:Iconify.Icon="{StaticResource IconSearch}"/>
    </Grid>
    <TabControl x:Name="Tabs" Grid.Row="2">
      <TabItem Header="Originaldateien"><TextBox x:Name="RawText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
      <TabItem Header="Erkannte Optionen"><TextBox x:Name="OptionsText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
      <TabItem Header="Server-Einbindung"><TextBox x:Name="ServerText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></TabItem>
    </TabControl>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
      <CheckBox x:Name="WrapBox" Content="Zeilenumbruch" Click="Wrap_Click" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button x:Name="CopySelectionButton" Content="Auswahl kopieren" Click="CopySelection_Click" Margin="0,0,8,0" icons:Iconify.Icon="{StaticResource IconCopy}"/>
      <Button Content="Alles kopieren" Click="CopyAll_Click" Margin="0,0,8,0" icons:Iconify.Icon="{StaticResource IconCopy}"/>
      <Button Content="Text exportieren" Click="Export_Click" Margin="0,0,8,0" icons:Iconify.Icon="{StaticResource IconExport}"/>
      <Button Content="Schließen" IsCancel="True" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconClose}"/>
    </WrapPanel>
  </Grid>
</Window>
