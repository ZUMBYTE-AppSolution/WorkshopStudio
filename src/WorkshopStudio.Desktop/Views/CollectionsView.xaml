<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.CollectionsView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12">
      <Button Content="Collection anlegen" Command="{Binding ActionCommand}" CommandParameter="new-collection" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconAdd}"/>
      <Button Content="Bearbeiten" Command="{Binding ActionCommand}" CommandParameter="edit-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconEdit}"/>
      <Button Content="Von Steam importieren" Command="{Binding ActionCommand}" CommandParameter="import-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconImport}"/>
      <Button Content="Lokal entfernen" Command="{Binding ActionCommand}" CommandParameter="delete-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
    </WrapPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection,Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="COLLECTION" Binding="{Binding Name}" Width="2*"/>
          <DataGridTextColumn Header="SPIEL" Binding="{Binding AppName}" Width="*"/>
          <DataGridTextColumn Header="EINTRÄGE" Binding="{Binding ItemCount}" Width="90"/>
          <DataGridTextColumn Header="VERKNÜPFUNG" Binding="{Binding LinkState}" Width="1.5*"/>
          <DataGridTextColumn Header="STEAM-ABRUF" Binding="{Binding SyncLabel}" Width="150"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <WrapPanel Grid.Row="2" Margin="0,16,0,8">
      <Button Content="Auf Steam anlegen" Command="{Binding ActionCommand}" CommandParameter="create-steam-collection" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconAdd}"/>
      <Button Content="Steam-Editor" Command="{Binding ActionCommand}" CommandParameter="open-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconEdit}"/>
      <Button Content="Steam-Stand lesen" Command="{Binding ActionCommand}" CommandParameter="refresh-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconRefresh}"/>
      <Button Content="Eigene Mods einreihen" Command="{Binding ActionCommand}" CommandParameter="queue-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconUpload}"/>
      <Button Content="IDs kopieren" Command="{Binding ActionCommand}" CommandParameter="copy-ids" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCopy}"/>
      <Button Content="JSON exportieren" Command="{Binding ActionCommand}" CommandParameter="export-collection" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconExport}"/>
      <Button Content="Zomboid-INI exportieren" Command="{Binding ActionCommand}" CommandParameter="export-zomboid" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconExport}"/>
    </WrapPanel>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16">
      <TextBlock Text="Lokale Collections bündeln deine Upload-Projekte. Echte Steam-Collections werden im eingebetteten originalen Steam-Editor angelegt und bearbeitet. Die lokale Auswahl wird nicht automatisch als Steam-Mitgliedschaft gespeichert. Externe Mods werden nicht neu hochgeladen." Style="{StaticResource Muted}"/>
    </Border>
  </Grid>
</UserControl>
