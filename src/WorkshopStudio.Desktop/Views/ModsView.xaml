<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.ModsView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel x:Name="LocalModActions" Margin="0,0,0,12">
      <Button Content="Mod hinzufügen" Command="{Binding ActionCommand}" CommandParameter="new-mod" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconAdd}"/>
      <Button Content="Mehrere Mods auswählen" Command="{Binding ActionCommand}" CommandParameter="match-local-mods" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCollection}"/>
      <Button Content="Bearbeiten" Command="{Binding ActionCommand}" CommandParameter="edit-mod" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconEdit}"/>
      <Button Content="Duplizieren" Command="{Binding ActionCommand}" CommandParameter="duplicate-mod" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCopy}"/>
      <Button Content="VDF importieren" Command="{Binding ActionCommand}" CommandParameter="import-vdf" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconImport}"/>
      <Button Content="Entfernen" Command="{Binding ActionCommand}" CommandParameter="delete-mod" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
    </WrapPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Zielkanal" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}"/>
        <ComboBox Width="115" ItemsSource="{Binding Channels}" SelectedItem="{Binding ReleaseTarget}"/>
      </StackPanel>
      <TextBlock Text="Test bleibt privat. Live nutzt die Sichtbarkeit der jeweiligen Mod." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/>
    </DockPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding VisibleMods}" SelectedItem="{Binding SelectedMod,Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="MOD / RESOURCE" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="QUELLE" Binding="{Binding SourceModeLabel}" Width="105"/>
          <DataGridTextColumn Header="SPIEL" Binding="{Binding AppName}" Width="1.2*"/>
          <DataGridTextColumn Header="LIVE-ID" Binding="{Binding WorkshopId}" Width="130"/>
          <DataGridTextColumn Header="TEST-ID" Binding="{Binding TestWorkshopId}" Width="130"/>
          <DataGridTextColumn Header="ÄNDERUNGEN" Binding="{Binding ChangeState}" Width="1.3*"/>
          <DataGridTemplateColumn Header="AUTO" Width="66">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding AutoPublish,Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <WrapPanel Grid.Row="3" Margin="0,16,0,0">
      <Button Content="Auswahl einreihen" Command="{Binding ActionCommand}" CommandParameter="queue-mod" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconUpload}"/>
      <Button Content="Alle sichtbaren einreihen" Command="{Binding ActionCommand}" CommandParameter="queue-all" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconUpload}"/>
      <Button Content="Upload-Inhalt prüfen" Command="{Binding ActionCommand}" CommandParameter="build-mod" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconScan}"/>
      <Button Content="Config / Befehle anzeigen" Command="{Binding ActionCommand}" CommandParameter="mod-config" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCode}"/>
      <Button Content="Änderungen prüfen" Command="{Binding ActionCommand}" CommandParameter="scan" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconScan}"/>
      <Button Content="Quellordner" Command="{Binding ActionCommand}" CommandParameter="open-source" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconFolder}"/>
      <Button Content="Steam-Seite / Tags" Command="{Binding ActionCommand}" CommandParameter="open-mod" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconExternal}"/>
    </WrapPanel>
  </Grid>
</UserControl>
