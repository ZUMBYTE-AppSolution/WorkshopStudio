<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.UpdatePlanWindow" Title="Workshop-Update prüfen" Width="820" Height="680" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,15"><TextBlock Text="Bestehenden Workshop-Eintrag aktualisieren" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="TargetText" Style="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="PAKET" Foreground="{DynamicResource AccentBrush}" FontSize="10"/><TextBlock x:Name="PackageText" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="METADATEN · nur ausgewählte Felder schreiben" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,12"/>
        <TextBlock x:Name="VersionDiff" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <CheckBox x:Name="TitleBox" Content="Titel ändern" Margin="0,0,0,8"/><TextBlock x:Name="TitleDiff" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,0,0,12"/>
        <CheckBox x:Name="DescriptionBox" Content="Beschreibung ändern" Margin="0,0,0,8"/><TextBlock x:Name="DescriptionDiff" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,0,0,12"/>
        <CheckBox x:Name="VisibilityBox" Content="Sichtbarkeit ändern" Margin="0,0,0,8"/><TextBlock x:Name="VisibilityDiff" Style="{StaticResource Muted}" Margin="20,0,0,12"/>
        <CheckBox x:Name="PreviewBox" Content="Lokales Vorschaubild hochladen" Margin="0,0,0,8"/><TextBlock x:Name="PreviewDiff" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,0,0,12"/>
        <CheckBox x:Name="ChangeNoteBox" Content="Neue Änderungsnotiz hinzufügen" Margin="0,0,0,8"/><TextBlock x:Name="NoteText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,0,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="Tags, Abhängigkeiten und alte Änderungsnotizen werden durch SteamCMD hier nicht geändert. Eine leere oder nicht abrufbare Angabe wird nicht automatisch zum Löschauftrag." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0" icons:Iconify.Icon="{StaticResource IconStop}"/><Button Content="Diesen Upload starten" Style="{StaticResource PrimaryButton}" Click="Accept_Click" icons:Iconify.Icon="{StaticResource IconUpload}"/></StackPanel>
  </Grid>
</Window>
