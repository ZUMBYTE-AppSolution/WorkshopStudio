<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.DashboardView" SizeChanged="Dashboard_SizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,5,0">
      <UniformGrid x:Name="KpiGrid" Columns="4" Margin="0,0,-12,8">
        <Border Style="{StaticResource Card}" Padding="17" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="62" Background="{DynamicResource InputBrush}" CornerRadius="8" HorizontalAlignment="Left"><Path Data="{StaticResource IconGame}" Width="29" Height="29" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TextBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Spiele / AppIDs" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding AppCount}" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="Verwaltete Spiele" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="17" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="62" Background="{DynamicResource InputBrush}" CornerRadius="8" HorizontalAlignment="Left"><Path Data="{StaticResource IconMod}" Width="29" Height="29" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Mods" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModCount}" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="Eigene Mod-Projekte" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="17" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="62" Background="{DynamicResource InputBrush}" CornerRadius="8" HorizontalAlignment="Left"><Path Data="{StaticResource IconCollection}" Width="29" Height="29" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Collections" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding CollectionCount}" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="Organisierte Sammlungen" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="17" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="45" Height="62" Background="{DynamicResource InputBrush}" CornerRadius="8" HorizontalAlignment="Left"><Path Data="{StaticResource IconUpload}" Width="29" Height="29" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Veröffentlichungen" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding PublishedCount}" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="{Binding QueueSummary}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Grid></Border>

      </UniformGrid>
      <Grid x:Name="ContentColumns"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="1.7*"/><ColumnDefinition x:Name="RightColumn" Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="LeftContent" Margin="0,0,18,0">
          <Border Style="{StaticResource Card}" Padding="19" Margin="0,0,0,18"><StackPanel>
            <DockPanel Margin="0,0,0,15"><Button DockPanel.Dock="Right" Content="Verwalten" Command="{Binding NavigateCommand}" CommandParameter="apps" FontSize="11" Padding="10,5" MinHeight="28" icons:Iconify.Icon="{StaticResource IconEdit}"/><TextBlock Text="Deine Spiele" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
            <ItemsControl ItemsSource="{Binding DashboardApps}" Margin="0,0,-10,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding GameColumns,RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Command="{Binding DataContext.EditAppCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Profile}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{DynamicResource InputBrush}" ToolTip="Spielprofil bearbeiten">
                  <Grid Height="96"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Margin="7" CornerRadius="5" Background="{DynamicResource PanelBrush}" ClipToBounds="True"><Grid><Path Data="{StaticResource IconGame}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/><Image Source="{Binding Profile.Artwork,Converter={StaticResource CachedImage}}" Stretch="Uniform"/></Grid></Border>
                    <StackPanel Grid.Column="1" Margin="9,8,10,7" VerticalAlignment="Center"><TextBlock Text="{Binding Profile.Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Profile.AppId,StringFormat=AppID: {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,3"/><TextBlock Text="{Binding ContentSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="Profil eingerichtet" FontSize="9" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/></StackPanel>
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Weitere AppID hinzufügen" Command="{Binding ActionCommand}" CommandParameter="new-app" HorizontalAlignment="Left" Padding="12,9" FontSize="11" icons:Iconify.Icon="{StaticResource IconAdd}"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="19" Margin="0,0,0,18"><StackPanel><TextBlock Text="Schnellaktionen" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/><UniformGrid x:Name="QuickActions" Columns="3" Margin="0,0,-8,-8">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ActionCommand}" CommandParameter="new-mod" Margin="0,0,8,8" Padding="11,11" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconMod}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Mod hinzufügen" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Command="{Binding ActionCommand}" CommandParameter="new-collection" Margin="0,0,8,8" Padding="11,11" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCollection}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Neue Collection" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Command="{Binding ActionCommand}" CommandParameter="new-app" Margin="0,0,8,8" Padding="11,11" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAdd}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="AppID hinzufügen" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Command="{Binding ActionCommand}" CommandParameter="login" Margin="0,0,8,8" Padding="11,11" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconLogin}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Steam-Login" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="queue" Margin="0,0,8,8" Padding="11,11" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconUpload}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Veröffentlichungen" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="0,0,8,8" Padding="11,11" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Einstellungen" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>

          </UniformGrid></StackPanel></Border>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="17" Margin="0,0,0,18"><StackPanel><TextBlock Text="Einzelmod rein. Workshop-Paket raus." FontWeight="SemiBold"/><TextBlock Text="Deinen eigenen Mod-Ordner auswählen. Studio ergänzt die Upload-Struktur und zeigt vorab die enthaltenen Dateien. Kein manuelles Kopieren des Spiels." Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border>
        </StackPanel>
        <Border x:Name="ActivityPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="19" VerticalAlignment="Top" Margin="0,0,0,18"><StackPanel>
          <DockPanel Margin="0,0,0,13"><Button DockPanel.Dock="Right" Content="Alle anzeigen" Command="{Binding NavigateCommand}" CommandParameter="history" Padding="9,5" FontSize="11" MinHeight="28" icons:Iconify.Icon="{StaticResource IconView}"/><TextBlock Text="Letzte Aktivitäten" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <Border Visibility="{Binding HasNoJobs,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource InputBrush}" CornerRadius="7" Padding="17" Margin="0,4,0,12"><StackPanel><TextBlock Text="Noch keine Veröffentlichungen" FontWeight="SemiBold"/><TextBlock Text="Uploads und ihre Ergebnisse erscheinen hier, sobald du dein erstes Paket prüfst und veröffentlichst." Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel></Border>
          <ItemsControl ItemsSource="{Binding RecentJobs}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,0,0"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource IconPending}"/><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding StatusLabel}" Value="Erfolgreich"><Setter Property="Data" Value="{StaticResource IconCheck}"/><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding StatusLabel}" Value="Fehler"><Setter Property="Data" Value="{StaticResource IconAlert}"/><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><StackPanel Grid.Column="1"><TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModName}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,7"/><DockPanel><TextBlock Text="{Binding Channel}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/><TextBlock Text="{Binding CreatedLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel></StackPanel></Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <StackPanel Margin="0,20,0,0"><TextBlock Text="UPLOAD-STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding LoginStatus}" Margin="0,7,0,0" FontSize="12"/><TextBlock Text="{Binding SuccessRate}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/><TextBlock Text="Kennzahlen aus deinem gespeicherten Verlauf." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        </StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
