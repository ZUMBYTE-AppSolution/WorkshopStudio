<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.ModPickerWindow" Title="Mod auswählen" Width="820" Height="610" MinWidth="650" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock x:Name="Heading" Text="Eine Mod auswählen" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Hint" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <ListBox x:Name="Choices" Grid.Row="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding IdLabel}" Foreground="{DynamicResource AccentBrush}" Margin="0,4"/><TextBlock Text="{Binding LayoutLabel}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Root}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="2" Margin="0,20,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0" icons:Iconify.Icon="{StaticResource IconStop}"/><Button Content="Auswahl übernehmen" Style="{StaticResource PrimaryButton}" Click="Accept_Click" IsDefault="True" icons:Iconify.Icon="{StaticResource IconCheck}"/></StackPanel><TextBlock Text="Nicht ausgewählte Mods werden nicht verpackt." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,20,0"/></DockPanel>
  </Grid>
</Window>
