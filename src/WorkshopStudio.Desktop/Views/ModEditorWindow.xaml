<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.ModEditorWindow" Title="Mod-Projekt" Width="960" Height="840" MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Mod-Projekt" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="WORKSHOP STUDIO" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,7,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <TabControl>
        <TabItem Header="Allgemein">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Spiel / App-Profil" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="AppBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding AppProfileId}" Margin="0,0,0,16"/>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Workshop-Titel" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Version,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Mod-ID(s) aus mod.info, getrennt mit Semikolon" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ModIdsBox" Text="{Binding ModIds,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Quellordner der einzelnen Mod (z. B. ...\mods\rp-core)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ContentBox" TextChanged="ContentChanged" Text="{Binding ContentFolder,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <WrapPanel Margin="0,0,0,15">
                <Button Content="Mod-Ordner wählen" Click="BrowseContent_Click" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconFolder}"/>
                <Button Content="Neue Mod-Struktur anlegen" Click="Template_Click" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconAdd}"/>
                <Button Content="Struktur &amp; IDs prüfen" Click="DetectIds_Click" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCode}"/>
                <Button Content="Metadaten erkennen" Click="DetectSchema_Click" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconScan}"/>
                <Button Content="Mehrmod-Paket zusammenstellen" Click="BrowseBundle_Click" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconPackage}"/>
              </WrapPanel>
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="WAS WIRD HOCHGELADEN?" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SourceStatus" Text="Noch keine Quelle geprüft." FontWeight="SemiBold" Margin="0,8,0,6"/>
                  <TextBlock x:Name="SourceMapping" Style="{StaticResource Muted}" FontSize="12"/>
                  <TextBlock Text="Du musst keinen Contents-Ordner anlegen. Studio erstellt die Upload-Struktur in einem getrennten temporären Paket. Deine Quelldateien und das Spiel werden nicht verändert." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <CheckBox Content="Mod für Uploads aktivieren" IsChecked="{Binding Enabled}"/>
              <CheckBox Content="Auto-Publish für diese Mod erlauben" IsChecked="{Binding AutoPublish}"/>
              <TextBlock Text="Auto-Publish benötigt zusätzlich die globale Freigabe. Quelldateien werden beim Veröffentlichen nicht verändert. Die Vorlagen erstellen neue Ordner und überschreiben keine vorhandenen Mods." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Workshop-Inhalt">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Beschreibung (bis 8000 UTF-8-Bytes)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Änderungsnotiz ({version} und {date} werden ersetzt)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ChangeNote,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Vorschaubild (PNG/JPEG, höchstens 1 MiB)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PreviewBox" Text="{Binding PreviewFile,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <Button Content="Bild wählen" Click="BrowsePreview_Click" HorizontalAlignment="Left" Margin="0,0,0,14" icons:Iconify.Icon="{StaticResource IconImage}"/>
              <Image Source="{Binding Text,ElementName=PreviewBox,Converter={StaticResource CachedImage}}" Height="150" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,16"/>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Tags als lokale Arbeitsnotiz (im Steam-Editor setzen)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <TextBlock Text="SteamCMD hat keinen hier verlässlich nutzbaren allgemeinen Tags-Editor. Tags, Abhängigkeiten, Screenshots und spielabhängige Spezialoptionen auf der originalen Steam-Seite bearbeiten. Diese Tags-Notiz wird nicht als Upload-Funktion ausgegeben." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Test &amp; Live">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Live-Workshop-ID (0 = beim ersten Upload neu anlegen)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding WorkshopId,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Test-Workshop-ID (separater Eintrag, 0 = neu anlegen)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding TestWorkshopId,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Titelzusatz im Testkanal" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding TestTitleSuffix,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/>
              </StackPanel>
              <TextBlock Text="Sichtbarkeit im Live-Kanal" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="VisibilityBox" SelectedIndex="{Binding Visibility}" Margin="0,0,0,18"/>
              <TextBlock Text="Test-Uploads sind immer privat. Live- und Test-ID dürfen nie identisch sein. „Live“ bedeutet nicht automatisch öffentlich; die gewählte Sichtbarkeit entscheidet." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Schutz nach unklarem Erst-Upload" Style="{StaticResource SectionTitle}"/>
                  <CheckBox Content="Live-Erst-Upload muss geprüft werden" IsChecked="{Binding NeedsLiveReconciliation,Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
                  <CheckBox Content="Test-Erst-Upload muss geprüft werden" IsChecked="{Binding NeedsTestReconciliation,Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
                  <TextBlock Text="Zuerst im Workshop nachsehen, ob ein neuer Eintrag entstanden ist. Vorhandene ID oben eintragen. Nur wenn sicher kein Eintrag existiert, die Sperre zurücksetzen." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                  <Button Content="Nach manueller Prüfung Sperre zurücksetzen" Click="ResetReconciliation_Click" HorizontalAlignment="Left" icons:Iconify.Icon="{StaticResource IconRefresh}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Dateien &amp; Notizen">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Zusätzliche Dateiausschlüsse für diese Mod" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Exclusions,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120"/>
              </StackPanel>
              <TextBlock Text="Globale und App-weite Filter werden zusätzlich angewendet. Kein automatisches Herunterladen oder Kopieren fremder Workshop-Mods. Dateien unter .env, .ssh und typische Schlüsseldateien werden bei aktiviertem Geheimnisfilter ausgeschlossen." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Interne Notizen (nicht veröffentlicht)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0" icons:Iconify.Icon="{StaticResource IconStop}"/>
      <Button Content="Speichern" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" icons:Iconify.Icon="{StaticResource IconSave}"/>
    </StackPanel>
  </Grid>
</Window>
