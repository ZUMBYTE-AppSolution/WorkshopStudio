<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.QueueView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="200"/>
    </Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12">
      <Button Content="Warteschlange starten" Command="{Binding ActionCommand}" CommandParameter="run-queue" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconPlay}"/>
      <Button Content="Laufenden Vorgang stoppen" Command="{Binding ActionCommand}" CommandParameter="stop" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconStop}"/>
      <Button Content="Wartenden Auftrag entfernen" Command="{Binding ActionCommand}" CommandParameter="cancel-job" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
    </WrapPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedJob,Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="MOD" Binding="{Binding ModName}" Width="1.5*"/>
          <DataGridTextColumn Header="KANAL" Binding="{Binding Channel}" Width="75"/>
          <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="110"/>
          <DataGridTextColumn Header="PAKET" Binding="{Binding SizeLabel}" Width="90"/>
          <DataGridTextColumn Header="ZEIT" Binding="{Binding DurationLabel}" Width="70"/>
          <DataGridTextColumn Header="ERGEBNIS" Binding="{Binding Message}" Width="2*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <TextBlock Grid.Row="2" Text="LIVE-PROTOKOLL · Passwörter und Codes werden nicht absichtlich protokolliert" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,17,0,9"/>
    <TextBox Grid.Row="3" Text="{Binding LiveLog,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  </Grid>
</UserControl>
