<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.HistoryView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <WrapPanel x:Name="HistoryActions" Margin="0,0,0,12">
      <Button Content="Protokoll öffnen" Command="{Binding ActionCommand}" CommandParameter="open-log" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconExternal}"/>
      <Button Content="Sicherung vor Update" Command="{Binding ActionCommand}" CommandParameter="open-job-backup" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconFolder}"/>
      <Button Content="Erneut einreihen" Command="{Binding ActionCommand}" CommandParameter="retry-job" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconUpload}"/>
      <Button Content="Verlauf leeren" Command="{Binding ActionCommand}" CommandParameter="clear-history" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
      <Button Content="Paket-Backups" Command="{Binding ActionCommand}" CommandParameter="open-backups" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconFolder}"/>
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding SuccessRate}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedJob,Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="MOD" Binding="{Binding ModName}" Width="1.5*"/>
          <DataGridTextColumn Header="KANAL" Binding="{Binding Channel}" Width="75"/>
          <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="110"/>
          <DataGridTextColumn Header="PAKET" Binding="{Binding SizeLabel}" Width="90"/>
          <DataGridTextColumn Header="ZEIT" Binding="{Binding DurationLabel}" Width="70"/>
          <DataGridTextColumn Header="ERGEBNIS" Binding="{Binding Message}" Width="2*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
