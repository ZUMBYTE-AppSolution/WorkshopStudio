<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services"
        x:Class="WorkshopStudio.Desktop.Views.LocalModMatchWindow" Style="{StaticResource StudioWindow}"
        Title="Lokale Mods zuordnen" Width="980" Height="740" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="25">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Lokale Mods zuordnen" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
      <TextBlock Text="Jede Zeile ist eine einzelne Mod. Eindeutige Treffer sind vorausgewählt; prüfe die Zuordnung und die Workshop-ID vor dem Übernehmen. Übersprungene Mods bleiben unverändert. Für zugeordnete Profile wird Auto-Publish ausgeschaltet. Es wird nichts veröffentlicht." Style="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ModRows">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,8,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="{Binding Candidate.DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Candidate.IdLabel}" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding Candidate.LayoutLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Candidate.Root}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="ZIELPROFIL" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,6"/>
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"/>
                  <TextBlock Text="{Binding MatchReason}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,15,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Abbrechen" IsCancel="True" Margin="0,0,10,0" icons:Iconify.Icon="{StaticResource IconStop}"/>
        <Button Content="Zuordnungen übernehmen" Style="{StaticResource PrimaryButton}" Click="Accept_Click" IsDefault="True" icons:Iconify.Icon="{StaticResource IconCheck}"/>
      </StackPanel>
      <TextBlock Text="Neue Profile starten ohne Workshop-ID und ohne Auto-Publish." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
