<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.AccountsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,10,0">
      <WrapPanel Margin="0,0,0,12">
        <Button Content="Konto hinzufügen" Command="{Binding ActionCommand}" CommandParameter="new-account" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconAdd}"/>
        <Button Content="Bearbeiten" Command="{Binding ActionCommand}" CommandParameter="edit-account" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconEdit}"/>
        <Button Content="Als Upload-Konto setzen" Command="{Binding ActionCommand}" CommandParameter="activate-account" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconLogin}"/>
        <Button Content="Entfernen" Command="{Binding ActionCommand}" CommandParameter="delete-account" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
      </WrapPanel>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount,Mode=TwoWay}" Height="180">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ANZEIGENAME" Binding="{Binding DisplayName}" Width="*"/>
            <DataGridTextColumn Header="STEAM-LOGINNAME" Binding="{Binding UserName}" Width="*"/>
            <DataGridCheckBoxColumn Header="PASSWORT MERKEN" Binding="{Binding RememberPassword}" Width="180"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="SteamCMD · Upload-Anmeldung" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Diese Anmeldung wird zum Veröffentlichen benötigt. SteamCMD verwendet zuerst seine gespeicherte Sitzung. Passwort, E-Mail-Code und mobile Freigabe werden bei Bedarf angefordert. Fehlende Installation und Konto werden beim Start angeboten." Style="{StaticResource Muted}" Margin="0,7,0,16"/>
          <TextBlock Text="{Binding ActiveAccountLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,13"/>
          <WrapPanel Margin="0,0,0,12">
            <Button Content="Für Uploads anmelden" Command="{Binding ActionCommand}" CommandParameter="login" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconLogin}"/>
            <Button Content="Originale SteamCMD-Konsole" Command="{Binding ActionCommand}" CommandParameter="interactive-login" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCode}"/>
            <Button Content="Vorgang stoppen" Command="{Binding ActionCommand}" CommandParameter="stop" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconStop}"/>
            <Button Content="Gespeichertes Passwort löschen" Command="{Binding ActionCommand}" CommandParameter="forget-password" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
            <Button Content="SteamCMD-Sitzungen entfernen" Command="{Binding ActionCommand}" CommandParameter="clear-cmd-session" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Steam Community · Originaler Weblogin" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Anmeldung direkt auf der Steam-Seite, einschließlich Steam Guard oder QR-Anmeldung, soweit Steam sie anbietet. Die Websitzung wird getrennt von SteamCMD behandelt. Ein Weblogin allein berechtigt SteamCMD nicht zum Upload." Style="{StaticResource Muted}" Margin="0,7,0,16"/>
          <TextBlock Text="{Binding WebLoginStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>
          <WrapPanel Margin="0,0,0,12">
            <Button Content="Steam-Weblogin öffnen" Command="{Binding ActionCommand}" CommandParameter="web-login" Margin="0,0,8,8"  icons:Iconify.Icon="{StaticResource IconLogin}"/>
            <Button Content="Websitzung löschen" Command="{Binding ActionCommand}" CommandParameter="clear-web-session" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconDelete}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Kopieren" Command="{Binding ActionCommand}" CommandParameter="copy-login-log" Margin="8,0,0,0" icons:Iconify.Icon="{StaticResource IconCopy}"/>
              <Button Content="Speichern" Command="{Binding ActionCommand}" CommandParameter="save-login-log" Margin="8,0,0,0" icons:Iconify.Icon="{StaticResource IconSave}"/>
            </WrapPanel>
            <TextBlock Text="Login-Protokoll" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox Text="{Binding LoginLog,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                   Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   TextWrapping="Wrap" TextChanged="LoginLog_Changed"/>
          <TextBlock Text="Eingegebene Passwörter und Codes werden maskiert. Kontonamen und lokale Pfade vor Weitergabe prüfen. Keine Zugangsdaten im Chat senden."
                     Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
