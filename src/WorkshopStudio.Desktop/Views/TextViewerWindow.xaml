<Window xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.TextViewerWindow" Width="960" Height="740" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Kopieren" Click="Copy_Click" Margin="0,0,8,0" icons:Iconify.Icon="{StaticResource IconCopy}"/>
      <Button Content="Als Text speichern" Click="Save_Click" Margin="0,0,8,0" icons:Iconify.Icon="{StaticResource IconSave}"/>
      <Button Content="Schließen" IsCancel="True" Style="{StaticResource PrimaryButton}" icons:Iconify.Icon="{StaticResource IconClose}"/>
    </WrapPanel>
    <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
