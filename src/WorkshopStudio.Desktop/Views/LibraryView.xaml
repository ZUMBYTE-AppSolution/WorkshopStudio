<UserControl xmlns:icons="clr-namespace:WorkshopStudio.Desktop.Services" Style="{StaticResource StudioView}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorkshopStudio.Desktop.Views.LibraryView">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12">
      <Button Content="Workshop-Inhalte ermitteln" Command="{Binding ActionCommand}" CommandParameter="scan-workshop" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconScan}"/>
      <Button Content="Auswahl importieren" Command="{Binding ActionCommand}" CommandParameter="import-workshop" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconImport}"/>
      <Button Content="Alle bestätigten importieren" Command="{Binding ActionCommand}" CommandParameter="import-all-workshop" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconImport}"/>
      <Button Content="Details / Schema" Command="{Binding ActionCommand}" CommandParameter="workshop-details" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCode}"/>
      <Button Content="Config / Befehle anzeigen" Command="{Binding ActionCommand}" CommandParameter="workshop-config" Margin="0,0,8,8" icons:Iconify.Icon="{StaticResource IconCode}"/>
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding WorkshopScanSummary}" Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0">
        <DataGrid ItemsSource="{Binding VisibleRemoteItems}" SelectedItem="{Binding SelectedRemoteItem,Mode=TwoWay}" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="SPIEL / APPID" Binding="{Binding AppLabel}" Width="110"/>
            <DataGridTextColumn Header="TITEL" Binding="{Binding Title}" Width="2*"/>
            <DataGridTextColumn Header="TYP" Binding="{Binding TypeLabel}" Width="125"/>
            <DataGridTextColumn Header="WORKSHOP-ID" Binding="{Binding Id}" Width="140"/>
            <DataGridTextColumn Header="STAND" Binding="{Binding LocalState}" Width="125"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="AUSGEWÄHLTER EINTRAG" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SelectedRemoteItem.Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,12"/>
          <TextBlock Text="AppID" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedRemoteItem.AppLabel}" Margin="0,0,0,9"/>
          <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedRemoteItem.VersionLabel}" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <Border Background="{DynamicResource InputBrush}" Height="160" Margin="0,0,0,9"><Image Source="{Binding SelectedRemoteItem.PreviewArtwork,Converter={StaticResource CachedImage}}" Stretch="Uniform"/></Border>
          <TextBlock Text="Vorschau-Bild (Steam-URL)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedRemoteItem.PreviewUrl,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="65" Margin="0,0,0,9"/>
          <TextBlock Text="Beschreibung (Originalformat)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedRemoteItem.Description,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="235" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="Remote-Daten werden nur gelesen. Ein Import erhält die Workshop-ID und lädt keine Quelldateien herunter." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
